# Formatting for every editor (IntelliJ and VS Code read this). Checked in CI by .github/scripts/lint.py.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,mcmeta,yml,yaml}]
indent_size = 2

[{gradlew,gradlew.bat}]
# Generated by Gradle.
indent_style = unset
